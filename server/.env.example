# CampusHire Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/campushire?retryWrites=true&w=majority

# ── JWT Secrets (use strong random strings — min 64 chars) ───────────────────
JWT_ACCESS_SECRET=replace-with-a-very-long-random-secret-for-access-tokens-min-64-chars
JWT_REFRESH_SECRET=replace-with-a-different-very-long-random-secret-for-refresh-tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookie ───────────────────────────────────────────────────────────────────
# In production set COOKIE_DOMAIN to your apex domain e.g. .campushire.io
COOKIE_DOMAIN=
# COOKIE_SECURE is set automatically based on NODE_ENV

# ── Client URL (for CORS and email links) ────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── SMTP (optional in dev — emails are logged to console if not set) ─────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
FROM_EMAIL=noreply@campushire.dev

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
INVITE_TOKEN_EXPIRES_HOURS=72

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
